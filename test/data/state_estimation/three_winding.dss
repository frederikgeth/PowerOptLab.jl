! Synthetic, grounded single-phase three-winding transformer oracle.
! 100 kVA per winding, 2400/1200/600 V, no excitation losses.
! Winding resistances: 1/.25/.0625 ohm (1.73611111111111% each).
! Pair reactances on winding-1 base: X12=2, X13=3, X23=2 ohm.
! The reference base is 2400^2/100000=57.6 ohm.
! Grounds use node 0 exactly; no fictitious small grounding impedance.
! Disable OpenDSS artificial anti-float shunts as well as excitation losses.
Clear
Set DefaultBaseFreq=50
New Circuit.three_winding phases=1 bus1=h.1.0 basekv=2.4 pu=1 angle=0 model=ideal
New Transformer.t phases=1 windings=3
~ wdg=1 bus=h.1.0 conn=wye kv=2.4 kva=100 %r=1.73611111111111
~ wdg=2 bus=l.1.0 conn=wye kv=1.2 kva=100 %r=1.73611111111111
~ wdg=3 bus=t.1.0 conn=wye kv=0.6 kva=100 %r=1.73611111111111
~ XHL=3.47222222222222 XHT=5.20833333333333 XLT=3.47222222222222
~ %noloadloss=0 %imag=0 ppm_antifloat=0
New Load.secondary phases=1 bus1=l.1.0 conn=wye kv=1.2 kw=10 kvar=2 model=1 Vminpu=0 Vmaxpu=2
New Load.tertiary phases=1 bus1=t.1.0 conn=wye kv=0.6 kw=5 kvar=1 model=1 Vminpu=0 Vmaxpu=2
Set VoltageBases=[2.4,1.2,0.6]
CalcVoltageBases
Set Tolerance=1e-11
Set MaxIterations=1000
Solve
